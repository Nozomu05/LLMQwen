# =============================================================
# LLM Service — copy this file to .env and fill in your values
# =============================================================

# ── Service / infrastructure ──────────────────────────────────
# URL of the vLLM OpenAI-compatible API server
# In Docker this is overridden to http://host.docker.internal:8000 by docker-compose
VLLM_BASE_URL=http://localhost:8000

# Maximum total context window (tokens) the vLLM server was started with (--max-model-len)
VLLM_MAX_CONTEXT=8192

# Estimated tokens consumed by the system prompt and formatting overhead
# Increase if answers are cut off; decrease to allow more context chunks
PROMPT_OVERHEAD_TOKENS=800

# Path to the SQLite file holding agent personas (id, name, profession, department,
# interests, behavior, folder, web_search). Auto-created with seed rows (TSP-0, MPEG-0,
# ...) on first connection — see services/agents_config.py
AGENTS_DB_PATH=storage/agents.db

# ── Model parameters ──────────────────────────────────────────
# Model ID served by vLLM — must match --served-model-name (or --model) exactly
VLLM_MODEL=Qwen/Qwen3-14B-AWQ

# Sampling temperature: 0.0 = fully deterministic, 1.0 = very creative
TEMPERATURE=0.1

# Hard ceiling on temperature, applied even if a caller explicitly requests
# higher (e.g. a frontend "creativity" slider). Higher temperature measurably
# increases the odds of the model drifting off the requested response
# language or under-using retrieved context — this doesn't eliminate that
# risk (it exists at any nonzero temperature) but bounds how bad it can get.
# _style_hint() in app.py adds an explicit language-anchor reminder at higher
# temperature specifically to counter this, which is what makes 1.0 safe to
# allow here — tested repeatedly at 0.95 with no drift.
MAX_TEMPERATURE=1.0

# Maximum number of new tokens the model may generate per answer
MAX_NEW_TOKENS=1024

# Nucleus sampling: only consider tokens whose cumulative probability ≤ TOP_P
# Set to 1.0 to disable (use temperature alone)
TOP_P=0.95

# Frequency penalty: penalise tokens that already appeared in the output
# 0.0 = no penalty, positive values reduce repetition
FREQUENCY_PENALTY=0.0

# Number of prior conversation turns (user+assistant pairs) included as context
# Optional — defaults to 10 if unset
MAX_HISTORY_TURNS=10
