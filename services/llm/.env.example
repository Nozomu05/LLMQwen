# =============================================================
# LLM Service — copy this file to .env and fill in your values
# =============================================================

# ── Service / infrastructure ──────────────────────────────────
# URL of the vLLM OpenAI-compatible API server
# In Docker this is overridden to http://host.docker.internal:8000 by docker-compose
VLLM_BASE_URL=http://localhost:8000

# Maximum total context window (tokens) the vLLM server was started with (--max-model-len)
VLLM_MAX_CONTEXT=8192

# Estimated tokens consumed by the system prompt and formatting overhead
# Increase if answers are cut off; decrease to allow more context chunks
PROMPT_OVERHEAD_TOKENS=800

# ── Model parameters ──────────────────────────────────────────
# Model ID served by vLLM — must match --served-model-name (or --model) exactly
VLLM_MODEL=Qwen/Qwen3-14B-AWQ

# Sampling temperature: 0.0 = fully deterministic, 1.0 = very creative
TEMPERATURE=0.1

# Maximum number of new tokens the model may generate per answer
MAX_NEW_TOKENS=1024

# Nucleus sampling: only consider tokens whose cumulative probability ≤ TOP_P
# Set to 1.0 to disable (use temperature alone)
TOP_P=0.95

# Frequency penalty: penalise tokens that already appeared in the output
# 0.0 = no penalty, positive values reduce repetition
FREQUENCY_PENALTY=0.0
