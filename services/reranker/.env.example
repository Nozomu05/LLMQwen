# =================================================================
# Reranker Service — copy this file to .env and fill in your values
# =================================================================

# ── Service / infrastructure ──────────────────────────────────────
# URL of the LLM service — reranked chunks are forwarded here for answer generation
# In Docker this is overridden to http://llm:8012 by docker-compose
LLM_SERVICE_URL=http://localhost:8012

# Device to run the cross-encoder on  (cuda:0 / cuda:1 / cpu)
RERANKER_DEVICE=cuda:0

# Number of top-scoring chunks to pass to the LLM after reranking
TOP_N_RERANK=10

# Batch size for cross-encoder inference — lower if the GPU runs out of memory
RERANKER_BATCH_SIZE=16

# Local directory where Hugging Face model weights are cached
HF_CACHE_DIR=/space/storage/homes/minh/.cache/huggingface
HF_HOME=/space/storage/homes/minh/.cache/huggingface

# ── Model parameters ──────────────────────────────────────────────
# Cross-encoder model used to score (query, chunk) pairs
# Changing this model changes ranking quality — re-evaluate after switching
RERANKER_MODEL_ML=BAAI/bge-reranker-v2-m3

# Maximum token length for each (query, passage) pair fed into the cross-encoder
# Pairs exceeding this are truncated; lower values speed up inference
RERANKER_MAX_LENGTH=512
