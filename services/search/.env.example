# ================================================================
# Search Service — copy this file to .env and fill in your values
# ================================================================

# ── Service / infrastructure ──────────────────────────────────────
# URL of the reranker service — retrieved chunks are sent here for scoring
# In Docker this is overridden to http://reranker:8011 by docker-compose
RERANKER_SERVICE_URL=http://localhost:8011

# URL of the LLM service — only used when USE_HYDE=true
# In Docker this is overridden to http://llm:8012 by docker-compose
LLM_SERVICE_URL=http://localhost:8012

# Path to the Chroma vector store on disk
# Must point to the directory that rag/ingest.py wrote to
CHROMA_DIR=storage/chroma

# Device for the embedding model  (cpu / cuda:0)
EMBEDDING_DEVICE=cuda:0

# Number of candidate chunks to retrieve from Chroma before reranking
RETRIEVAL_CHUNKS=50

# Enable HyDE (Hypothetical Document Embeddings) — adds one extra LLM call per query
# Improves recall on vague questions; disable for faster responses
USE_HYDE=false

# Local directory where Hugging Face model weights are cached
HF_CACHE_DIR=/space/storage/homes/minh/.cache/huggingface
HF_HOME=/space/storage/homes/minh/.cache/huggingface

# ── Model parameters ──────────────────────────────────────────────
# Embedding backend:
#   huggingface — any model via sentence-transformers (GPU/CPU)
#   fastembed   — optimised ONNX runtime, fewer available models (CPU only)
EMBEDDING_PROVIDER_ML=huggingface

# Embedding model ID — must be IDENTICAL to the model used during ingestion
# Changing this requires a full re-run of rag/ingest.py
EMBEDDING_MODEL_ML=intfloat/multilingual-e5-large-instruct

# L2-normalise embedding vectors before similarity search  (true / false)
# Should match how the index was built — keep true for cosine-similarity indexes
EMBEDDING_NORMALIZE=true
