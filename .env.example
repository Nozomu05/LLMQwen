# ============================================================
# LLM backend
# ============================================================
# LLM_BACKEND: vllm (production) | transformers (fallback, loads model directly)
# Start the vLLM server first with: bash serve.sh
LLM_BACKEND=vllm
VLLM_BASE_URL=http://localhost:8000
SEARCH_SERVICE_URL=http://localhost:8010
RERANKER_SERVICE_URL=http://localhost:8011
LLM_SERVICE_URL=http://localhost:8012
VLLM_PORT=8000
VLLM_MODEL=Qwen/Qwen3-14B-AWQ
MAX_NEW_TOKENS=1024
TEMPERATURE=0.1

# ============================================================
# DEVICES  (GPU 0 = RTX 2080 Ti 11GB, GPU 1 = RTX 5090 32GB)
# ============================================================
RERANKER_DEVICE=cuda:0    # bge-reranker-v2-m3 on 2080 Ti (~2.2GB) — processes 80 chunks per query
EMBEDDING_DEVICE=cpu      # multilingual-e5-large on CPU — only embeds 1 query per request

# ============================================================
# DOCUMENTS & CHUNKING
# ============================================================
DOCS_DIR=docs
CHROMA_DIR=storage/chroma
BATCH_SIZE=100
CHUNK_SIZE=1800          # ⚠️ changing this requires re-running: python rag/ingest.py
CHUNK_OVERLAP=180        # ~10% of CHUNK_SIZE
CHUNKING_STRATEGY=adaptive   # adaptive | semantic | fixed

# ============================================================
# EMBEDDING MODEL  (multilingual — EN, FR, and others)
# ============================================================
EMBEDDING_PROVIDER_ML=huggingface
EMBEDDING_MODEL_ML=intfloat/multilingual-e5-large-instruct

# ============================================================
# RERANKER
# ============================================================
RERANKER_MODEL_ML=BAAI/bge-reranker-v2-m3
USE_RERANKING=true
RETRIEVAL_CHUNKS=50      # initial pool before reranking (increase if corpus grows)
TOP_N_RERANK=10         # chunks passed to the LLM after reranking
RERANKER_BATCH_SIZE=16
USE_HYDE=false

# ============================================================
# CACHE  (local path to avoid GlusterFS network overhead)
# ============================================================
HF_CACHE_DIR=/space/storage/homes/minh/.cache/huggingface
HF_HOME=/space/storage/homes/minh/.cache/huggingface
TRITON_CACHE_DIR=/tmp/triton_cache
