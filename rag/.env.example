# ============================================================
# Ingestion job — copy this file to .env and fill in your values
# In Docker, DOCS_DIR / CHROMA_DIR / HF_* are overridden by docker-compose
# ============================================================

# ── Infrastructure / pipeline ──────────────────────────────────
# Directory containing the raw documents to ingest
# ZIP archives inside this folder are extracted automatically
DOCS_DIR=docs

# Output directory where the Chroma vector store will be written
# Must match CHROMA_DIR in the search service's .env
CHROMA_DIR=storage/chroma

# Number of document chunks added to Chroma in a single batch
# Lower this if you hit memory errors during indexing
BATCH_SIZE=100

# Chunk size in characters for text splitting
# ⚠ Changing this requires a full re-run of ingestion
CHUNK_SIZE=1800

# Overlap between consecutive chunks (~10% of CHUNK_SIZE recommended)
CHUNK_OVERLAP=180

# Chunking strategy:
#   adaptive — section-heading split → semantic → row-boundary for tables (best for MPEG docs)
#   semantic — SemanticChunker for text, row-boundary for tables
#   fixed    — RecursiveCharacterTextSplitter only (fastest, least accurate)
CHUNKING_STRATEGY=adaptive

# Device for the embedding model during ingestion  (cpu / cuda:0)
EMBEDDING_DEVICE=cuda:0

# Local directory where Hugging Face model weights are cached
HF_CACHE_DIR=/space/storage/homes/minh/.cache/huggingface
HF_HOME=/space/storage/homes/minh/.cache/huggingface

# ── Model parameters ──────────────────────────────────────────
# Embedding backend:
#   huggingface — any model via sentence-transformers (GPU/CPU)
#   fastembed   — optimised ONNX runtime, fewer available models (CPU only)
EMBEDDING_PROVIDER_ML=huggingface

# Embedding model ID — must be IDENTICAL to the model used in the search service
# ⚠ Changing this requires a full re-run of ingestion
EMBEDDING_MODEL_ML=intfloat/multilingual-e5-large-instruct

# Number of document chunks to embed in a single forward pass
# Larger batches are faster but use more GPU/CPU memory
EMBEDDING_BATCH_SIZE=32
